# ─── App ──────────────────────────────────────────────────────────────
# URL pública HTTPS. Apple y Google la usan para actualizar los pases.
# En local, usa un túnel (cloudflared / ngrok) para probar en un celular.
NEXT_PUBLIC_APP_URL=https://yamerito.mx

# Secreto para /api/jobs/run (Vercel Cron o Supabase pg_cron lo mandan como Bearer)
CRON_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# ─── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Apple Wallet (opcional al inicio) ────────────────────────────────
APPLE_PASS_TYPE_ID=pass.mx.yamerito.sellos
APPLE_TEAM_ID=
# PEM en base64: npm run certs:base64 -- wwdr.pem signerCert.pem signerKey.pem
APPLE_WWDR_CERT_BASE64=
APPLE_SIGNER_CERT_BASE64=
APPLE_SIGNER_KEY_BASE64=
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_APNS_HOST=api.push.apple.com

# ─── Google Wallet (opcional al inicio) ───────────────────────────────
GOOGLE_WALLET_ISSUER_ID=
# JSON de la cuenta de servicio en base64
GOOGLE_WALLET_SA_JSON_BASE64=

# ─── Mercado Pago (cobro de suscripciones) ────────────────────────────
# Tus integraciones → tu aplicación → Credenciales de producción
MP_ACCESS_TOKEN=
# Tus integraciones → Webhooks → "Clave secreta" (para validar x-signature)
MP_WEBHOOK_SECRET=

# ─── Solo para npm run seed ───────────────────────────────────────────
SEED_EMAIL=duena@cafelaesquina.mx
SEED_PASSWORD=cambia-esta-clave
SEED_NEGOCIO=Café La Esquina
SEED_GIRO=cafeteria
SEED_NOMBRE=Lupita
